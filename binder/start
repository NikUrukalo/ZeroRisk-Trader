#!/bin/bash
set -e

export BOTTLE_PORT=8080
export BOTTLE_HOST=0.0.0.0
export BOTTLE_ROOT=${JUPYTERHUB_SERVICE_PREFIX}proxy/${BOTTLE_PORT}/
export BOTTLE_RELOADER=0        # the reloader forks; it does not belong here
export BOTTLE_DEBUG=0

export POSTGRES_PORT=443

# Start the app in the background and keep its output, so that if the page
# stays blank you can open a Binder terminal and read the traceback:
#     cat /tmp/zerorisk.log
python app.py > /tmp/zerorisk.log 2>&1 &

exec "$@"
